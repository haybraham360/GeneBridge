  "radius": { "card": "20px", "input": "14px", "tile": "16px", "pill": "999px" },
  "shadow": { "card": "0 8px 24px rgba(60,30,10,0.06)" },
  "font": {
    "latin": "Plus Jakarta Sans",
    "arabic": "IBM Plex Sans Arabic",
