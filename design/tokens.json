    "h1": { "size": "32px", "weight": 800, "tracking": "-0.02em" },
    "h2": { "size": "20px", "weight": 800, "tracking": "-0.01em" },
    "body": { "size": "15px", "lineHeight": 1.55 },
    "small": { "size": "13px" }
  },
  "layout": { "maxWidth": "1240px", "sidebarWidth": "240px", "minTouchTarget": "44px" },
  "rules": [
    "Primary orange buttons use dark ink text, never white (white on #FF5A1F fails contrast).",
    "Orange text on light backgrounds uses orangeText #C2410C, not #FF5A1F.",
    "Never distinguish affected / carrier / unaffected by colour alone; always add a label."
  ]
