# Supabase project (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SERVICE_ROLE_KEY=

# "Continue with Google" appears automatically once the Google provider is on in
# Supabase. Set to false to hide it anyway.
GOOGLE_AUTH_ENABLED=
# Phone code sign-in. Off for now; turn on once the Supabase Phone provider
# (or its test numbers) is set up.
PHONE_AUTH_ENABLED=false

# Demo mode (task 15). false for real use: hides the UAE PASS test
# identities, the family-notice demo links and, unless synthetic analytics
# data exists, the "Synthetic demo data" labels. Set true only for a demo
# with the seeded personas. Remove demo data with npm run purge:demo.
NEXT_PUBLIC_DEMO_MODE=false

# Ask GeneBridge (task 06). Leave ANTHROPIC_API_KEY empty to run in offline
# mode: answers come from the content library with fixed templates, at no
# cost. With a key, replies come from Claude, still checked before display.
ANTHROPIC_API_KEY=
# Main model (default claude-opus-5-5). claude-haiku-5-5 is the cheapest.
ASSISTANT_MODEL=
# Small model for the message classifier (default claude-haiku-5-5).
ASSISTANT_CLASSIFIER_MODEL=
# Grading model for `npm run eval:assistant -- --ai --grade` (default claude-opus-5-5).
ASSISTANT_GRADER_MODEL=

# Family notices (task 08). Secret used to hash relatives' phone numbers
# (HMAC-SHA256). Any long random string; keep it the same once notices exist,
# or "Stop them" won't match earlier sends. Required in production.
NOTICE_PHONE_SALT=

# Report scanner (task 12). Reading a photographed report needs
# ANTHROPIC_API_KEY (above). Model with vision for reading reports
# (default claude-opus-5-5).
SCAN_MODEL=
# Set to 1 to let the model smooth the wording of catalogue explanations.
# Off by default: the reviewed catalogue wording is used as-is. A rewrite is
# only kept if it passes the output check (no new facts or numbers).
SCAN_SMOOTH=
# Test only, never in production: uploads named like a sample report
# (samples/reports/) return that sample's correct reading, so Playwright
# tests don't need the AI service. Ignored when NODE_ENV=production.
SCAN_TEST_EXTRACTOR=
# Protects /api/scan/cleanup (Vercel Cron sends it as a Bearer token). The
# cron in vercel.json runs daily, which Hobby plans allow; every scan also
# sweeps uploads older than 15 minutes. On Pro, run it every 10 minutes.
CRON_SECRET=

# Natural-sounding voices for Listen (task 12). Leave TTS_PROVIDER empty to
# use the browser's built-in speech. Supported:
#   elevenlabs — set ELEVENLABS_API_KEY (elevenlabs.io → Developers → API Keys).
#   azure — set AZURE_SPEECH_KEY and AZURE_SPEECH_REGION (uaenorth keeps
#           audio processing in the UAE).
TTS_PROVIDER=
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional voice overrides. ElevenLabs: voice IDs (default "Sarah" for both);
# Azure: voice names (defaults ar-AE-FatimaNeural, en-GB-SoniaNeural).
TTS_VOICE_AR=
TTS_VOICE_EN=
# Optional ElevenLabs model (default eleven_multilingual_v2;
# eleven_flash_v2_5 uses half the credits).
TTS_MODEL=

# Describe your family (task 13). Uses ANTHROPIC_API_KEY (above). Model for
# turning descriptions into tree changes (default claude-opus-5-5) and its
# effort (low, medium or high; default low, for speed).
FAMILY_MODEL=
FAMILY_EFFORT=
# Test only, never in production: descriptions are read by the rule-based
# planner instead of the AI, so Playwright tests don't need the AI service.
FAMILY_TEST_PLANNER=
# Cloud speech-to-text for voice descriptions. Leave empty to use the
# browser's speech recognition. Supported: azure (uses AZURE_SPEECH_KEY and
# AZURE_SPEECH_REGION above).
STT_PROVIDER=

# Professional verification (task 14). Encrypts verification documents
# (AES-256-GCM) before they reach the private kyc-documents bucket. 32 random
# bytes, base64: `openssl rand -base64 32`. Required in production; keep it
# once documents exist. Local development falls back to a derived key.
KYC_ENCRYPTION_KEY=
# Vision model for the AI pre-check (default claude-opus-5-5). Uses
# ANTHROPIC_API_KEY above; without a key, admins review without the pre-check.
KYC_MODEL=
# Optional identity verification provider (ID authenticity, face match),
# behind lib/kyc/provider.ts. Leave empty: admins compare the selfie themselves.
KYC_PROVIDER=
# Email at each verification status change, on top of in-app notifications.
# Leave empty until an email service is set up.
KYC_EMAIL_PROVIDER=
# Test only, never in production: the pre-check returns a fixed reading for
# the sample documents (samples/kyc/), so Playwright doesn't call the AI.
KYC_TEST_PRECHECK=

# Booking, chat and Google Meet (task 15).
# The site's public address: links in emails and calendar events point here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Calendar (each professional connects their own). See README.md →
# "Google Meet links". Leave empty and professionals paste a video link instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Encrypts stored Google refresh tokens: `openssl rand -base64 32`. Required in
# production; development falls back to a key derived from the service role key.
CALENDAR_TOKEN_KEY=
# Optional email notifications: resend (with RESEND_API_KEY and EMAIL_FROM) or
# log. Emails never contain message text, names or health details.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=GeneBridge <no-reply@example.com>
