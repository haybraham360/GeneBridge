# Supabase project (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SERVICE_ROLE_KEY=

# "Continue with Google" appears automatically once the Google provider is on in
# Supabase. Set to false to hide it anyway.
GOOGLE_AUTH_ENABLED=
# Phone code sign-in. Off for now; turn on once the Supabase Phone provider
# (or its test numbers) is set up.
PHONE_AUTH_ENABLED=false

# Labels every dashboard figure "Synthetic demo data" (guardrail 12). Keep
# true while the synthetic seed (npm run seed:analytics) is in the database.
NEXT_PUBLIC_DEMO_DATA=true

# Enables the UAE PASS mock dialog (demo identities). Leave unset in production.
DEMO_UAE_PASS_ENABLED=true

# Ask GeneBridge (task 06). Leave ANTHROPIC_API_KEY empty to run in offline
# mode: answers come from the content library with fixed templates, at no
# cost. With a key, replies come from Claude, still checked before display.
ANTHROPIC_API_KEY=
# Main model (default claude-opus-5-5). claude-haiku-5-5 is the cheapest.
ASSISTANT_MODEL=
# Small model for the message classifier (default claude-haiku-5-5).
ASSISTANT_CLASSIFIER_MODEL=
# Grading model for `npm run eval:assistant -- --ai --grade` (default claude-opus-5-5).
ASSISTANT_GRADER_MODEL=
